{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SCOPE output",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "task_id": {
   "type": "string",
   "pattern": "^T-\\d{6}$"
  },
  "study_id": {
   "type": "string"
  },
  "agent": {
   "const": "tfm-scope-auditor"
  },
  "model_id": {
   "type": "string",
   "minLength": 3
  },
  "notes": {
   "type": [
    "string",
    "null"
   ]
  },
  "proposed_class": {
   "enum": [
    "A",
    "B",
    "C",
    "D",
    "E",
    "X"
   ]
  },
  "reason": {
   "type": "string",
   "minLength": 10
  },
  "evidence": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "locator": {
      "type": "string"
     },
     "quote": {
      "type": "string",
      "maxLength": 400
     }
    },
    "required": [
     "locator",
     "quote"
    ],
    "additionalProperties": false
   }
  },
  "confidence": {
   "enum": [
    "HIGH",
    "MEDIUM",
    "LOW"
   ]
  }
 },
 "required": [
  "task_id",
  "study_id",
  "agent",
  "model_id",
  "proposed_class",
  "reason",
  "evidence",
  "confidence"
 ]
}