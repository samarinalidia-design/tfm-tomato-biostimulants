{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "DEDUP output",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "task_id": {
   "type": "string",
   "pattern": "^T-\\d{6}$"
  },
  "study_id": {
   "type": "string"
  },
  "agent": {
   "const": "tfm-dedup-linker"
  },
  "model_id": {
   "type": "string",
   "minLength": 3
  },
  "notes": {
   "type": [
    "string",
    "null"
   ]
  },
  "relations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "study_a": {
      "type": "string"
     },
     "study_b": {
      "type": "string"
     },
     "relation": {
      "enum": [
       "DUPLICATE_DATA",
       "PREPRINT_OF",
       "COMPANION_SHARED_EXPERIMENT",
       "SHARED_CONTROLS",
       "SAME_LAB_INDEPENDENT",
       "UNRELATED"
      ]
     },
     "evidence": {
      "type": "string",
      "minLength": 20
     },
     "confidence": {
      "enum": [
       "HIGH",
       "MEDIUM",
       "LOW"
      ]
     },
     "source_file_id": {
      "type": "string"
     },
     "receipt_id": {
      "type": "string"
     }
    },
    "required": [
     "study_a",
     "study_b",
     "relation",
     "evidence",
     "confidence",
     "source_file_id",
     "receipt_id"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "task_id",
  "study_id",
  "agent",
  "model_id",
  "relations"
 ]
}