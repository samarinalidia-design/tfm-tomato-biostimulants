{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "AUDIT output",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "task_id": {
   "type": "string",
   "pattern": "^T-\\d{6}$"
  },
  "study_id": {
   "type": "string"
  },
  "agent": {
   "const": "tfm-qa-auditor"
  },
  "model_id": {
   "type": "string",
   "minLength": 3
  },
  "notes": {
   "type": [
    "string",
    "null"
   ]
  },
  "items": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "tv_id": {
      "type": "integer"
     },
     "verdict": {
      "enum": [
       "CORRECT",
       "INCORRECT",
       "UNSURE"
      ]
     },
     "field_errors": {
      "type": "array",
      "items": {
       "enum": [
        "mean",
        "dispersion_type",
        "dispersion_value",
        "n",
        "unit",
        "arm_mapping",
        "timepoint",
        "endpoint_attrs",
        "locator"
       ]
      }
     },
     "corrected": {
      "type": [
       "object",
       "null"
      ]
     },
     "notes": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "tv_id",
     "verdict",
     "field_errors"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "task_id",
  "study_id",
  "agent",
  "model_id",
  "items"
 ]
}